# =============================================================================
# Trend Laundry Backend — environment configuration
# Copy to .env for local dev. Never commit .env. Never commit real secrets.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development
# api | worker  — main.ts chooses the entry based on this
ROLE=api
PORT=3000
LOG_LEVEL=debug
# Comma-separated origins allowed by CORS; use '*' only in local dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database -----------------------------------------------------------------
# Postgres connection string. In prod, prefer discrete env vars + connection
# pooling handled by the process. Kysely will use these directly.
DATABASE_URL=postgres://trend:trend@localhost:5432/trend_laundry
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# For read-only report queries; falls back to DATABASE_URL if unset.
DATABASE_REPLICA_URL=

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth ---------------------------------------------------------------------
# JWT signing: RS256 in production. For local dev we default to HS256 with a
# random secret so the box works out of the box. Never ship HS256 to prod.
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-in-production-this-is-only-for-local-dev-min-32-chars
# When JWT_ALGORITHM=RS256, provide these instead of JWT_SECRET:
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=v1

ACCESS_TOKEN_TTL_SECONDS=900       # 15 min
REFRESH_TOKEN_TTL_SECONDS=2592000  # 30 days

# Cookie settings for refresh tokens
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                # true in production (HTTPS)
COOKIE_SAMESITE=lax

# Argon2id parameters. Do not lower these without security review.
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --- Multi-tenant boundaries --------------------------------------------------
# Superuser / operator IP allowlist for /admin. Comma-separated CIDRs.
ADMIN_IP_ALLOWLIST=127.0.0.1/32

# --- Feature flags (v1 skeletons) --------------------------------------------
FEATURE_MFA_ENABLED=true
FEATURE_EMAIL_VERIFICATION=false   # off in Phase 0; needs mail provider

# --- Rate limits --------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_IP_PER_MIN=10
RATE_LIMIT_LOGIN_PER_EMAIL_PER_HOUR=5
RATE_LIMIT_DEFAULT_PER_USER_PER_MIN=120
