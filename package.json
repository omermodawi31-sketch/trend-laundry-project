{
  "name": "trend-laundry-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/lib/migrate.ts up",
    "migrate:down": "tsx src/lib/migrate.ts down",
    "migrate:status": "tsx src/lib/migrate.ts status",
    "seed:dev": "tsx db/seeds/development.ts"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/jwt": "^8.0.1",
    "kysely": "^0.27.4",
    "pg": "^8.12.0",
    "argon2": "^0.40.3",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8",
    "nanoid": "^5.0.7",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.3",
    "tsx": "^4.16.2",
    "vitest": "^2.0.3",
    "@vitest/coverage-v8": "^2.0.3",
    "eslint": "^9.7.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0"
  }
}
